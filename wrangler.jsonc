{
  // ⚠ "name" must be EXACTLY your Worker's name as shown in the Cloudflare dashboard
  //   (Workers & Pages → your project → the name at the top). Change it here if it differs.
  "name": "acri-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
  // Optional: point at a different Apps Script deployment without editing code
  // "vars": { "APPS_SCRIPT_URL": "https://script.google.com/macros/s/…/exec" }
}
